{
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(belgrano|norcenter|imax|imax-norcenter|haedo|quilmes|cordoba|villa-allende|rosario)",
      "destination": "/index.html"
    },
    {
      "source": "/(belgrano|norcenter|imax|imax-norcenter|haedo|quilmes|cordoba|villa-allende|rosario)/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/icon.(svg|png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
