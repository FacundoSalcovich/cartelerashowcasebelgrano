{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/cartelera",
      "destination": "/api/cartelera.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*).(css|js|svg|png|jpg|webp|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
